# Supabase (Postgres) bağlantısı — boş bırakılırsa yerel SQLite kullanılır (data/trendmatik.db).
# Vercel gibi sunucusuz ortamlarda ZORUNLUDUR (orada SQLite çalışmaz).
#
# Supabase panosunda: Project Settings → Database → Connection string → URI
# Sunucusuz ortamda "Transaction pooler" (port 6543) adresini kullanın.
# Örnek:
# DATABASE_URL=postgresql://postgres.abcdefghijkl:PAROLANIZ@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Oturum çerezlerini imzalayan gizli anahtar (en az 32 karakter).
# Sunucusuz ortamda ZORUNLU. Yerelde boş bırakılırsa data/secret.key üretilir.
# Yeni değer üretmek için:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Google ile giriş — İSTEĞE BAĞLI. Boş bırakılırsa özellik tamamen kapalıdır
# (arayüzde düğme çıkmaz, /api/auth/google 404 döner); e-posta + parola girişi çalışmaya devam eder.
#
# console.cloud.google.com → APIs & Services → Credentials → Create credentials
#   → OAuth client ID → Web application
# "Authorized redirect URIs" alanına şunu ekleyin (yayın adresinizle):
#   https://SITENIZ/api/auth/google/geri
#   http://localhost:3000/api/auth/google/geri     (yerel geliştirme için)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Yönlendirme adresinin doğru üretilmesi için yayın adresi.
# Vercel'de otomatik algılanır; özel alan adı kullanıyorsanız yazın.
# NEXT_PUBLIC_SITE_URL=https://trendmatik.com

# ---- E-posta (doğrulama, parola sıfırlama, bülten) — İSTEĞE BAĞLI ----
# Tanımlı değilse gönderim yapılmaz; bağlantılar sunucu kaydına yazılır
# (yerelde akışı böyle test edebilirsiniz). resend.com üzerinden ücretsiz
# başlanabilir; kendi alan adınızı doğrulamadan yalnızca onboarding@resend.dev
# adresinden gönderim yapılabilir.
RESEND_API_KEY=
# EPOSTA_GONDEREN="TrendMatik <bildirim@siteniz.com>"

# ---- Hata bildirimi — İSTEĞE BAĞLI ----
# Hatalar her durumda tek satır JSON olarak sunucu kaydına yazılır.
# Buraya bir Slack/Discord webhook adresi verirseniz özet oraya da düşer.
# HATA_WEBHOOK_URL=

# ---- Zamanlanmış gündem taraması ----
# vercel.json'daki cron bu uca istek atar. Tanımlı değilse uç 404 döner
# ve tarama yalnızca yönetim panelinden elle tetiklenebilir.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# ---- Web push bildirimleri — İSTEĞE BAĞLI ----
# Tanımlı değilse bildirim düğmesi görünmez, uçlar 404 döner.
# Anahtar çifti üretmek için: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_KONU=mailto:iletisim@siteniz.com
